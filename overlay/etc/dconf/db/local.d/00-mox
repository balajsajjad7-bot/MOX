[org/gnome/desktop/interface]
color-scheme='prefer-dark'
accent-color='slate'
gtk-theme='Yaru-dark'
icon-theme='Papirus-Dark'
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='JetBrains Mono 11'
enable-animations=true
clock-show-weekday=true
clock-format='12h'
show-battery-percentage=true
enable-hot-corners=true

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'
titlebar-font='Inter Semi-Bold 11'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/mox/mox-living.xml'
picture-uri-dark='file:///usr/share/backgrounds/mox/mox-living.xml'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/mox/day.jpg'

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true
natural-scroll=true

[org/gnome/mutter]
center-new-windows=true

[org/gnome/shell]
favorite-apps=['mox-install.desktop','org.mox.ThisPC.desktop','org.gnome.Nautilus.desktop','org.mox.Browser.desktop','org.mox.Mail.desktop','org.gnome.Ptyxis.desktop','org.mox.Control.desktop','org.mox.Bot.desktop','org.mox.Modo.desktop','org.mox.Player.desktop','org.gnome.Settings.desktop']
enabled-extensions=['blur-my-shell@aunetx','ubuntu-dock@ubuntu.com','ubuntu-appindicators@ubuntu.com','mox-widgets@mox.os','ding@rastersoft.com','GPaste@gnome-shell-extensions.gnome.org']

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=true
dash-max-icon-size=48
transparency-mode='FIXED'
background-opacity=0.22
custom-theme-shrink=true
show-trash=true
show-mounts=true
show-mounts=false
show-apps-at-top=false
click-action='minimize-or-previews'
custom-theme-running-dots-color='#ffffff'
running-indicator-style='DOTS'
disable-overview-on-startup=true

[org/gnome/shell/extensions/blur-my-shell/applications]
blur=true
enable-all=true
sigma=40
opacity=210
dynamic-opacity=false

[org/gnome/desktop/sound]
theme-name='mox'
event-sounds=true
input-feedback-sounds=false
allow-volume-above-100-percent=false

[org/gnome/shell/extensions/ding]
show-home=false
show-trash=true
show-volumes=true
icon-size='standard'
start-corner='top-left'

[org/gnome/desktop/privacy]
remove-old-trash-files=true
remove-old-temp-files=true
old-files-age=uint32 30

[org/gnome/settings-daemon/plugins/media-keys]
logout=@as []
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/mox-power/','/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/mox-tasks/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/mox-power]
name='MOX Power'
command='mox-power'
binding='<Control><Alt>Delete'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/mox-tasks]
name='MOX Task Manager'
command='mox-tasks'
binding='<Control><Shift>Escape'

[org/gnome/GPaste]
max-history-size=500
max-displayed-history-size=40
images-support=true
trim-items=true
show-history='<Super>v'
track-changes=true
