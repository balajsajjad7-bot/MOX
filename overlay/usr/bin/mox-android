#!/bin/bash
# Opens Android on the MOX desktop, starting it first when needed.
if ! command -v waydroid >/dev/null || [ ! -f /var/lib/waydroid/images/system.img ]; then
  notify-send "Android isn't set up yet" "Run: sudo mox get android"
  exit 1
fi
systemctl is-active --quiet waydroid-container || pkexec systemctl restart waydroid-container
waydroid status 2>/dev/null | grep -qi 'session:.*running' || { waydroid session start >/dev/null 2>&1 & sleep 8; }
exec waydroid show-full-ui
