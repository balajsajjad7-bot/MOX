#!/usr/bin/env bash
# Publishes a signed update that every installed MOX downloads within about 6 hours.
# Usage: tools/mox-publish VERSION
set -euo pipefail
version="$1"; repo="$(cd "$(dirname "$0")/.." && pwd)"
current="$(cat "$repo/overlay/usr/lib/mox/VERSION")"
if [[ "$(printf '%s\n%s\n' "$current" "$version" | sort -V | tail -1)" != "$version" || "$current" == "$version" ]]; then
  echo "Version must be newer than $current." >&2; exit 1
fi
work="$(mktemp -d)"; trap 'rm -rf "$work"' EXIT
mkdir -p "$work/payload/rootfs"
echo "$version" > "$repo/overlay/usr/lib/mox/VERSION"
cp -a "$repo/overlay/usr" "$work/payload/rootfs/usr"
mkdir -p "$work/payload/rootfs/usr/lib/mox"
cp -a "$repo/dialer" "$work/payload/rootfs/usr/lib/mox/dialer"
cat > "$work/payload/post-install.sh" <<'POST'
#!/bin/bash
glib-compile-schemas /usr/share/glib-2.0/schemas
update-desktop-database /usr/share/applications
gtk-update-icon-cache -f /usr/share/icons/hicolor || true
systemctl daemon-reload
dconf update || true
systemctl enable mox-firstboot.timer mox-optimize.service || true
POST
"$repo/tools/mox-release" "$version" "$work/payload" "$repo/dist/$version"
gh release create "v$version" "$repo/dist/$version"/* --title "MOX $version" --notes "Signed MOX update." --latest
echo "Published $version."
